# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://ynkwvqnxgunvcrstiwec.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never expose or commit.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay (Dashboard -> Account & Settings -> API Keys). Use TEST keys until launch. ----
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks. Endpoint: https://<your-domain>/api/razorpay/webhook  Events: payment.captured, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# ---- Email confirmations (resend.com). Optional: without it, emails are logged instead of sent. ----
RESEND_API_KEY=
EMAIL_FROM="Raamattva Vidya Peeth <hello@your-domain>"
# Where new registrations, orders and enquiries are notified
TEAM_NOTIFY_EMAIL=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 once an SMS/WhatsApp provider is configured in Supabase Auth -> Phone
NEXT_PUBLIC_PHONE_LOGIN=0

# ---- Optional: recordings (bunny.net Stream) ----
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
# ---- Optional: phone sign-in channel when NEXT_PUBLIC_PHONE_LOGIN=1 (sms or whatsapp) ----
OTP_CHANNEL=sms
